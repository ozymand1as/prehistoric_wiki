# Primitive Tech Wiki - Git Ignore

# OS files
.DS_Store
Thumbs.db

# Git
.git/

# PI agent files
.pi/
.prototools

# Build artifacts
*.swp
*.swo

# State and temporary files (keep these untracked)
state.md

# Jekyll build artifacts
_site/
.sass-cache/
.gulp/
*.css.map
npm-debug.log*

# Exclude but track subdirectories
# wiki content is tracked
# docs content is tracked